# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — never commit real values; keep a .env.example instead
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# build artifacts
*.apk
*.aab
*.ipa
# generated native folders
/ios
/android

# Electron desktop shell (isolated sibling package)
electron/node_modules/
electron/release/
/android


# graphify (local knowledge graph)
graphify-out/cost.json
# graphify-out/cache/         # optional: commit for speed, skip to keep repo small